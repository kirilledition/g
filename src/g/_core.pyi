from collections.abc import Sequence

import numpy as np
import numpy.typing as npt

class cli:  # noqa: N801 - extension submodule name
    class NativeCliRunResult:
        @property
        def exit_code(self) -> int: ...
        @property
        def stdout_chunks(self) -> tuple[str, ...]: ...
        @property
        def stderr_chunks(self) -> tuple[str, ...]: ...

    @staticmethod
    def run(arguments: Sequence[str]) -> NativeCliRunResult: ...

class engine:  # noqa: N801 - extension submodule name
    class JaxBackendConfig:
        @property
        def association_mode(self) -> str: ...
        @property
        def correction(self) -> JaxCorrectionConfig: ...
        @property
        def linear(self) -> JaxLinearConfig: ...
        @property
        def binary(self) -> JaxBinaryConfig: ...

    class JaxCorrectionConfig:
        @property
        def method(self) -> str: ...
        @property
        def p_threshold(self) -> float: ...
        @property
        def firth_se(self) -> bool: ...

    class JaxLinearConfig:
        @property
        def minimum_variance(self) -> float: ...
        @property
        def relative_variance_tolerance(self) -> float: ...

    class JaxBinaryConfig:
        @property
        def numerical(self) -> JaxBinaryNumericalConfig: ...
        @property
        def null_logistic(self) -> JaxBinaryNullLogisticConfig: ...
        @property
        def firth_candidate(self) -> JaxFirthCandidateConfig: ...
        @property
        def approximate_firth(self) -> JaxApproximateFirthConfig: ...
        @property
        def null_firth(self) -> JaxNullFirthConfig: ...

    class JaxBinaryNumericalConfig:
        @property
        def minimum_probability(self) -> float: ...
        @property
        def minimum_variance(self) -> float: ...
        @property
        def relative_variance_tolerance(self) -> float: ...

    class JaxBinaryNullLogisticConfig:
        @property
        def maximum_iterations(self) -> int: ...
        @property
        def coefficient_tolerance(self) -> float: ...

    class JaxFirthCandidateConfig:
        @property
        def batch_size(self) -> int: ...
        @property
        def candidate_capacity(self) -> int: ...

    class JaxApproximateFirthConfig:
        @property
        def maximum_iterations(self) -> int: ...
        @property
        def gradient_tolerance(self) -> float: ...
        @property
        def coefficient_tolerance(self) -> float: ...
        @property
        def likelihood_tolerance(self) -> float: ...
        @property
        def maximum_step_size(self) -> float: ...
        @property
        def pseudo_maximum_iterations(self) -> int: ...
        @property
        def pseudo_inner_maximum_iterations(self) -> int: ...
        @property
        def newton_raphson_zero_start_iterations(self) -> int: ...
        @property
        def line_search_maximum_attempts(self) -> int: ...
        @property
        def step_halving_maximum_attempts(self) -> int: ...
        @property
        def initial_response_scale(self) -> float: ...
        @property
        def sparse_carrier_dosage_threshold(self) -> float: ...
        @property
        def step_halving_scale(self) -> float: ...
        @property
        def use_block_math(self) -> bool: ...

    class JaxNullFirthConfig:
        @property
        def maximum_iterations(self) -> int: ...
        @property
        def gradient_tolerance(self) -> float: ...
        @property
        def maximum_step_size(self) -> float: ...
        @property
        def fallback_iteration_multiplier(self) -> int: ...
        @property
        def fallback_step_divisor(self) -> float: ...
        @property
        def line_search_maximum_attempts(self) -> int: ...
        @property
        def step_halving_scale(self) -> float: ...

    class JaxGroupInput:
        @property
        def phenotype_matrix(self) -> npt.NDArray[np.float32]: ...
        @property
        def covariate_matrix(self) -> npt.NDArray[np.float32]: ...

    class JaxGenotypeBatch:
        @property
        def dosage_matrix(self) -> npt.NDArray[np.float32] | None: ...
        @property
        def packed8_probabilities(self) -> npt.NDArray[np.uint8] | None: ...
        @property
        def dosage_sum(self) -> npt.NDArray[np.float32]: ...
        @property
        def observation_count(self) -> npt.NDArray[np.int32]: ...
        @property
        def imputed_dosage_square_sum(self) -> npt.NDArray[np.float32] | None: ...
        @property
        def rare_sparse_mask(self) -> npt.NDArray[np.bool_] | None: ...

    class JaxMaterializationRequest:
        @property
        def active_trait_indices(self) -> list[int]: ...

    class JaxPreparedChromosome:
        def __init__(
            self,
            *,
            state: object,
            null_logistic_converged: npt.NDArray[np.bool_] | None,
        ) -> None: ...
