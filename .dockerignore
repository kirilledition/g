# Only first-party build inputs enter the image context.
**
!.dockerignore
!README.md
!LICENSE
!pyproject.toml
!uv.lock
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!src/
!src/**
!crates/
!crates/**
!native/
!native/**
!vendor/
!vendor/openxla/
!vendor/openxla/**
!tooling/
!tooling/**
!deploy/
!deploy/workbench/
!deploy/workbench/**
# Never send generated binaries, local credentials or participant data.
**/__pycache__/**
**/*.pyc
**/*.so
**/*.o
**/*.a
**/.env*
**/*credentials*
**/*secret*
**/*.bgen
**/*.bgi
**/*.pgen
**/*.pvar
**/*.psam
**/*.sample
**/*.loco
**/*.bed
**/*.bim
**/*.fam
**/*.vcf*
**/*.parquet
**/*.log
**/*.pem
**/*.key
**/*.p12
**/target/**
**/.venv/**
**/results/**
/data/**
**/.git/**
